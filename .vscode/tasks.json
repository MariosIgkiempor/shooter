{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build atlas + run game",
      "type": "shell",
      "command": "${workspaceFolder}/build.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build game (debug)",
      "type": "shell",
      "command": "odin run vendor/atlas-builder -out:atlas-builder.bin && odin build . -debug -out:shooter-debug.bin",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
